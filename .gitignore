*.deb
*.dsc
*.changes
*.tar.gz
*.buildinfo
*.upload

# === Upstream code ===
opt/bash-it/
!opt/.keep

# === Logs and temp ===
*.log
*.tmp
*~
.*.swp
.swp
.swo

# === Editor and IDE files ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

